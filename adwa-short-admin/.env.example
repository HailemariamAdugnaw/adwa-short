# ────────────────────────────────────────────────────────────
# ADWA SHORT Admin — Environment
# Copy to `.env` and adjust. Vite only exposes vars prefixed with VITE_.
# ────────────────────────────────────────────────────────────

# Base URL the browser will hit. In dev, leave empty to use the Vite proxy
# (recommended — avoids CORS). In production, point at the deployed backend.
VITE_API_BASE_URL=

# Used only by vite.config.ts proxy target (server-side, never exposed to browser)
VITE_API_PROXY_TARGET=http://localhost:8000
