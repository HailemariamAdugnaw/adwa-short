# ADWA SHORT mobile environment configuration.
# Copy this file to `.env` and adjust values as needed.

# Backend API base URL. The mobile app will prefix all endpoint paths with this.
# For Android emulators use http://10.0.2.2:8000 to reach host's localhost.
API_BASE_URL=http://10.0.2.2:8000

# App environment: dev | staging | prod
APP_ENV=dev

# Default locale code (BCP-47)
DEFAULT_LOCALE=en

# Connect timeout for HTTP requests (ms)
HTTP_CONNECT_TIMEOUT=15000

# Read timeout for HTTP requests (ms)
HTTP_READ_TIMEOUT=30000

# Whether to enable verbose HTTP logging in dev
HTTP_LOG_ENABLED=true
